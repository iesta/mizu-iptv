# Copier en `.env` (ou dans ~/.config/mizu/.env) puis renseigner.
# Ces valeurs peuvent aussi être saisies dans l'écran de configuration
# (Préférences) ou passées en variables d'environnement.
#
# Aucune clé n'est compilée dans l'application.

# Instance Supabase (voir re/supabase/ pour la tienne)
MIZU_BACKEND_URL=https://api.zeniptv.app
MIZU_PUBLISHABLE_KEY=

# Optionnel : métadonnées TMDB (titres et affiches des favoris/reprise)
MIZU_TMDB_KEY=
